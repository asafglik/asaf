{
  "id": "1001",
  "name": "חשבונית מס - דוגמה",
  "description": "תבנית לדוגמה: טבלת פריטים עם מעבר עמודים, שדות מחושבים, QR וברקוד",
  "version": 1,
  "page": {
    "size": "A4",
    "orientation": "portrait"
  },
  "schema": {
    "format": "xml",
    "sample": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<invoice number=\"2026-0457\">\n  <date>2026-11-12</date>\n  <dueDate>2026-12-12</dueDate>\n  <company>\n    <name>אלפא מערכות בע\"מ</name>\n    <taxId>514789632</taxId>\n    <address>רחוב הברזל 12, תל אביב</address>\n  </company>\n  <customer>\n    <name>ישראל ישראלי</name>\n    <id>032145678</id>\n    <address>שדרות רוטשילד 45, תל אביב</address>\n    <email>israel@example.co.il</email>\n    <vip>true</vip>\n  </customer>\n  <vat>18</vat>\n  <items>\n    <item><sku>A-100</sku><description>רישיון תוכנה שנתי</description><qty>2</qty><price>1200</price></item>\n    <item><sku>B-220</sku><description>שעות ייעוץ והטמעה</description><qty>12</qty><price>350</price></item>\n    <item><sku>C-310</sku><description>הדרכת משתמשים באתר הלקוח</description><qty>1</qty><price>1800</price></item>\n  </items>\n  <notes>התשלום יבוצע בהעברה בנקאית תוך 30 יום.</notes>\n</invoice>\n",
    "arrays": [
      "items.item"
    ]
  },
  "pages": [
    {
      "id": "p1",
      "elements": [
        {
          "id": "e1",
          "type": "rect",
          "x": 0,
          "y": 0,
          "w": 210,
          "h": 34,
          "fill": "#1f3a68",
          "borderWidth": 0,
          "showOn": "all"
        },
        {
          "id": "e2",
          "type": "field",
          "name": "שם החברה",
          "x": 70,
          "y": 7,
          "w": 128,
          "h": 11,
          "binding": "company.name",
          "style": {
            "fontFamily": "Heebo",
            "fontSize": 20,
            "bold": true,
            "color": "#ffffff"
          }
        },
        {
          "id": "e3",
          "type": "text",
          "x": 70,
          "y": 18,
          "w": 128,
          "h": 12,
          "text": "ח.פ. {{company.taxId}}\n{{company.address}}",
          "style": {
            "fontFamily": "Heebo",
            "fontSize": 9,
            "color": "#dbe4f3"
          }
        },
        {
          "id": "e4",
          "type": "barcode",
          "name": "QR",
          "x": 12,
          "y": 5,
          "w": 24,
          "h": 24,
          "symbology": "qrcode",
          "valueMode": "expression",
          "expression": "\"INV:\" & @number & \";TOTAL:\" & round(sum(items.item, price*qty)*(1+vat/100),2)",
          "style": {
            "background": "#ffffff",
            "padding": 1
          }
        },
        {
          "id": "e5",
          "type": "text",
          "x": 110,
          "y": 40,
          "w": 88,
          "h": 10,
          "text": "חשבונית מס מספר {{@number}}",
          "style": {
            "fontFamily": "Heebo",
            "fontSize": 16,
            "bold": true,
            "color": "#1f3a68"
          }
        },
        {
          "id": "e6",
          "type": "text",
          "x": 12,
          "y": 40,
          "w": 80,
          "h": 14,
          "text": "תאריך: {{date | date:dd/MM/yyyy}}\nלתשלום עד: {{dueDate | date:dd/MM/yyyy}}",
          "style": {
            "fontFamily": "Heebo",
            "fontSize": 9.5,
            "align": "left"
          },
          "showOn": "first"
        },
        {
          "id": "e7",
          "type": "rect",
          "x": 110,
          "y": 52,
          "w": 88,
          "h": 26,
          "fill": "#f3f6fb",
          "borderWidth": 0.5,
          "borderColor": "#c5d0e3",
          "radius": 2,
          "showOn": "first"
        },
        {
          "id": "e8",
          "type": "text",
          "x": 113,
          "y": 54,
          "w": 82,
          "h": 22,
          "text": "לכבוד: {{customer.name}}\nת.ז.: {{customer.id}}\n{{customer.address}}\n{{customer.email}}",
          "style": {
            "fontFamily": "Heebo",
            "fontSize": 10,
            "lineHeight": 1.35
          },
          "showOn": "first"
        },
        {
          "id": "e9",
          "type": "text",
          "x": 12,
          "y": 58,
          "w": 60,
          "h": 8,
          "text": "לקוח VIP ★",
          "visibleIf": "customer.vip == true",
          "style": {
            "fontFamily": "Heebo",
            "fontSize": 11,
            "color": "#b26a00",
            "bold": true,
            "align": "left"
          },
          "showOn": "first"
        },
        {
          "id": "e10",
          "type": "table",
          "name": "פריטים",
          "x": 12,
          "y": 84,
          "w": 186,
          "h": 150,
          "binding": "items.item",
          "overflow": "paginate",
          "continueTop": 40,
          "continueHeight": 225,
          "style": {
            "fontFamily": "Heebo",
            "fontSize": 9.5
          },
          "headerStyle": {
            "background": "#1f3a68",
            "color": "#ffffff",
            "fontSize": 9.5
          },
          "altRowBackground": "#f3f6fb",
          "borderWidth": 0.5,
          "borderColor": "#c5d0e3",
          "cellPadding": 1.2,
          "columns": [
            {
              "id": "c1",
              "header": "#",
              "expression": "$row",
              "width": 0.6,
              "align": "center"
            },
            {
              "id": "c2",
              "header": "מק\"ט",
              "binding": "sku",
              "width": 1.3,
              "align": "center",
              "cellType": "value"
            },
            {
              "id": "c3",
              "header": "תיאור",
              "binding": "description",
              "width": 4.5
            },
            {
              "id": "c4",
              "header": "כמות",
              "binding": "qty",
              "width": 1,
              "align": "center",
              "format": "number:0"
            },
            {
              "id": "c5",
              "header": "מחיר יחידה",
              "binding": "price",
              "width": 1.6,
              "align": "left",
              "format": "currency",
              "footer": "סה\"כ לפני מע\"מ"
            },
            {
              "id": "c6",
              "header": "סה\"כ",
              "expression": "price * qty",
              "width": 1.7,
              "align": "left",
              "format": "currency",
              "footer": "{{sum($rows, price*qty) | currency}}"
            }
          ]
        },
        {
          "id": "e11",
          "type": "text",
          "x": 44,
          "y": 238,
          "w": 38,
          "h": 7,
          "text": "מע\"מ ({{vat}}%):",
          "style": {
            "fontFamily": "Heebo",
            "fontSize": 10,
            "align": "right"
          },
          "showOn": "last"
        },
        {
          "id": "e12",
          "type": "computed",
          "name": "מע\"מ",
          "x": 12,
          "y": 238,
          "w": 32,
          "h": 7,
          "expression": "sum(items.item, price*qty) * vat / 100",
          "format": "currency",
          "style": {
            "fontFamily": "Heebo",
            "fontSize": 10,
            "align": "left"
          },
          "showOn": "last"
        },
        {
          "id": "e13",
          "type": "text",
          "x": 44,
          "y": 246,
          "w": 38,
          "h": 8,
          "text": "סה\"כ לתשלום:",
          "style": {
            "fontFamily": "Heebo",
            "fontSize": 12,
            "align": "right",
            "bold": true
          },
          "showOn": "last"
        },
        {
          "id": "e14",
          "type": "computed",
          "name": "סה\"כ לתשלום",
          "x": 12,
          "y": 246,
          "w": 32,
          "h": 8,
          "expression": "sum(items.item, price*qty) * (1 + vat / 100)",
          "format": "currency",
          "style": {
            "fontFamily": "Heebo",
            "fontSize": 12,
            "align": "left",
            "bold": true,
            "color": "#1f3a68"
          },
          "showOn": "last"
        },
        {
          "id": "e15",
          "type": "line",
          "x": 12,
          "y": 236,
          "w": 70,
          "h": 1,
          "thickness": 0.75,
          "color": "#1f3a68",
          "showOn": "last"
        },
        {
          "id": "e16",
          "type": "field",
          "x": 90,
          "y": 238,
          "w": 108,
          "h": 16,
          "binding": "notes",
          "style": {
            "fontFamily": "Heebo",
            "fontSize": 9,
            "color": "#444444",
            "italic": true
          },
          "showOn": "last"
        },
        {
          "id": "e17",
          "type": "barcode",
          "x": 140,
          "y": 262,
          "w": 58,
          "h": 16,
          "symbology": "code128",
          "valueMode": "field",
          "binding": "@number",
          "showText": true
        },
        {
          "id": "e18",
          "type": "line",
          "x": 12,
          "y": 282,
          "w": 186,
          "h": 1,
          "thickness": 0.5,
          "color": "#999999"
        },
        {
          "id": "e19",
          "type": "text",
          "x": 12,
          "y": 284,
          "w": 186,
          "h": 6,
          "text": "עמוד {{page}} מתוך {{pages}}",
          "style": {
            "fontFamily": "Heebo",
            "fontSize": 8,
            "align": "center",
            "color": "#666666"
          }
        }
      ]
    }
  ]
}