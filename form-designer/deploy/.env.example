# domain of the cloud server (DNS A record -> server IP)
DOMAIN=forms.example.com
# admin key: designer and management screen. Long random string, e.g.: openssl rand -hex 32
FD_API_KEY=
# render tabs in parallel: about the number of CPU cores
FD_MAX_CONCURRENT=4
# optional: smart design agent
ANTHROPIC_API_KEY=
# 1 = install LibreOffice in the image (exact-layout Word import, about +400MB)
WITH_LIBREOFFICE=0
